# Copy this file to .env and fill in the value locally.
# Never commit the real key.
IMAGEGEN_API_KEY=

# Any service implementing a compatible Images API can be used.
IMAGEGEN_BASE_URL=https://api.openai.com/v1
IMAGEGEN_MODEL=gpt-image-2.5-sunburst

# Optional JSON object for provider-specific HTTP headers.
# IMAGEGEN_HEADERS_JSON={"X-Provider-Project":"example"}

# Optional path to a TOML configuration file.
# IMAGEGEN_CONFIG=.imagegen.toml
